    {
      "id": "RUSTSEC-2026-0221",
      "summary": "`event-listener` allows `!Send` tags to cross thread boundaries via `StackSlot`",
      "details": "Affected versions of `event-listener` unconditionally implement `Send` and\n`Sync` for `StackSlot<'_, T>`, the stack-allocated listener type created\nby the `listener!` macro.\n\nThis allows a `!Send` tag type set via `Event::with_tag` to be moved to\nanother thread and accessed via `StackSlot::wait`, causing a data race in safe\ncode.",
      "modified": "2026-07-31T12:15:04.629484145Z",
      "published": "2026-07-13T12:00:00Z",
      "database_specific": {
        "license": "CC0-1.0"
      },
      "references": [
